{
 "name": "nis_f3_margin_debt_deleveraging",
 "description": "FINRA monthly customer margin debit balances (1997-01+), 12-month growth z-score -> SPY timing, monthly.",
 "assumptions": [
  "published ~3rd week of the following month; revisions small but unaudited",
  "dev 1997-03..2011-10 (14.7y), val 2011-11..2026-07 (14.7y)",
  "monthly equity returns: skew -0.6, exkurt 2, D ASSUMPTION 1.2 (persistent signal)",
  "implied net Sharpe 0.15-0.3 (ASSUMPTION; the 'margin debt peaks' literature is mostly contemporaneous)",
  "stress drag 0.03"
 ],
 "design": "timeseries",
 "params": {
  "periods_per_year": 12,
  "autocorr": {
   "model": "lrv",
   "D": 1.2
  },
  "skew": -0.6,
  "exkurt": 2.0,
  "mean_ann": 0.0375,
  "vol_ann": 0.15
 },
 "windows": {
  "dev_years": 14.7,
  "val_years": 14.7
 },
 "gates": {
  "batch_k": 2,
  "stress_drag_sr": 0.03,
  "dev": {
   "kind": "amendment2"
  },
  "val": {
   "kind": "tstat",
   "alpha": "auto",
   "floor": 0.3
  },
  "pav": {
   "k_val": 2,
   "floor": 0.3
  }
 },
 "scenarios": [
  {
