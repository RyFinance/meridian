{
 "name": "nis_f5_crypto_dated_basis_term",
 "description": "BTC dated-futures annualised basis (BitMEX 2014-11+, Deribit 2016-12+, Binance 2020-09+) as a timing signal for BTC, daily (365).",
 "assumptions": [
  "only BTC/ETH have dated futures on the free archives: no cross-section (Binance USD-M delivery folders are BTC/ETH only)",
  "dev 2015-01..2020-10 (5.8y), val 2020-11..2026-08 (5.8y)",
  "D ASSUMPTION 1.1, skew -0.5, exkurt 10, vol 65%",
  "implied net Sharpe 0.3-0.8 (ASSUMPTION)",
  "stress drag 0.02"
 ],
 "design": "timeseries",
 "params": {
  "periods_per_year": 365,
  "autocorr": {
   "model": "lrv",
   "D": 1.1
  },
  "skew": -0.5,
  "exkurt": 10.0,
  "mean_ann": 0.325,
  "vol_ann": 0.65
 },
 "windows": {
  "dev_years": 5.8,
  "val_years": 5.8
 },
 "gates": {
  "batch_k": 2,
  "stress_drag_sr": 0.02,
  "dev": {
   "kind": "amendment2"
  },
  "val": {
   "kind": "tstat",
   "alpha": "auto",
   "floor": 0.3
  },
  "pav": {
   "k_val": 2,
   "floor": 0.3
  }
 },
 "scenarios": [
