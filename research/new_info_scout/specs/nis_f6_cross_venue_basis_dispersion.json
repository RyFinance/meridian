{
 "name": "nis_f6_cross_venue_basis_dispersion",
 "description": "Dispersion of perp/dated/spot basis for the same coin across Binance, Bybit, BitMEX, Deribit, OKX; convergence trade, daily 2020-01+ (the first date >= 3 venues are survivor-free).",
 "assumptions": [
  "dev 2020-01..2023-04 (3.3y), val 2023-05..2026-08 (3.3y)",
  "D ASSUMPTION 1.3 (convergence P&L autocorrelated), skew -1, exkurt 15",
  "implied net Sharpe after cross-venue fees/borrow 0.5-1.5 (ASSUMPTION)",
  "stress drag 0.3 (fees dominate)"
 ],
 "design": "timeseries",
 "params": {
  "periods_per_year": 365,
  "autocorr": {
   "model": "lrv",
   "D": 1.3
  },
  "skew": -1.0,
  "exkurt": 15.0,
  "mean_ann": 0.08,
  "vol_ann": 0.1
 },
