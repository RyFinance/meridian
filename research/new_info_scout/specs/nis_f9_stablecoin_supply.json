{
 "name": "nis_f9_stablecoin_supply",
 "description": "Aggregate stablecoin net issuance (DefiLlama, 2017-11+, usable 2019+) -> BTC timing, daily.",
 "assumptions": [
  "dev 2019-01..2022-10 (3.8y), val 2022-11..2026-08 (3.8y)",
  "not point-in-time (re-derived history)",
  "D 1.1, skew -0.5, exkurt 10, vol 60%",
  "implied 0.2-0.6"
 ],
 "design": "timeseries",
 "params": {
  "periods_per_year": 365,
  "autocorr": {
   "model": "lrv",
   "D": 1.1
  },
  "skew": -0.5,
  "exkurt": 10.0,
  "mean_ann": 0.24,
  "vol_ann": 0.6
 },
 "windows": {
  "dev_years": 3.8,
  "val_years": 3.8
 },
 "gates": {
  "batch_k": 2,
  "stress_drag_sr": 0.02,
  "dev": {
   "kind": "amendment2"
  },
  "val": {
   "kind": "tstat",
   "alpha": "auto",
   "floor": 0.3
  },
  "pav": {
   "k_val": 2,
   "floor": 0.3
  }
 },
 "scenarios": [
  {
   "label": "implied net S=0.2",
   "params": {
    "mean_ann": 0.12,
    "vol_ann": 0.6
   }
  },
  {
