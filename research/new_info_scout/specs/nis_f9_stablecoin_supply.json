   "params": {
    "mean_ann": 0.18,
    "vol_ann": 0.6
   }
  },
  {
   "label": "implied net S=0.45",
   "params": {
    "mean_ann": 0.27,
    "vol_ann": 0.6
   }
  },
  {
   "label": "implied net S=0.6",
   "params": {
    "mean_ann": 0.36,
    "vol_ann": 0.6
   }
  },
  {
   "label": "implied net S=0.8",
   "params": {
    "mean_ann": 0.48,
    "vol_ann": 0.6
   }
  }
 ]
