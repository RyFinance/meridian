{
 "name": "pro_crypto200_daily",
 "description": "200 crypto perps x 5y daily, directional per-asset strategy pooled.",
 "assumptions": [
  "ASSUMPTION per-market Sharpe grid 0.2-0.4",
  "a market-neutral cross-sectional book escapes rho only to the extent its signal is orthogonal to the common factor (see the long_short design)"
 ],
 "design": "panel",
 "params": {
  "n_markets": 200,
  "periods_per_year": 252,
  "rho": 0.6,
  "autocorr": 0.05,
  "skew": -0.5,
  "exkurt": 8.0,
  "sharpe_per_market": 0.3
 },
 "windows": {
  "dev_years": 2.5,
  "val_years": 2.5
 },
 "gates": {
  "batch_k": 1,
  "stress_drag_sr": 0.1,
  "dev": {
   "kind": "amendment2"
  },
  "val": {
   "kind": "sharpe",
   "value": 0.75,
   "alpha": "auto"
  }
 },
