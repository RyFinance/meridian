{
 "name": "pro_cs500_daily_ls",
 "description": "500 stocks x 10y, daily decile long-short.",
 "assumptions": [
  "ASSUMPTION daily residual cross-sectional sd 2%",
  "ASSUMPTION signal daily autocorr 0.95",
  "ASSUMPTION 5 bp one-way",
  "tilt0.25 = signal's R^2 on the correlated factor 0.25; LITERAL = brief's N/(1+(N-1) rho) on the held bets"
 ],
 "design": "long_short",
 "params": {
  "n_assets": 500,
  "periods_per_year": 252,
  "ic": 0.02,
  "cs_dispersion": 0.02,
  "quantile": 0.1,
  "rho_resid": 0.2,
  "rho_signal": 0.25,
  "signal_autocorr": 0.95,
  "cost_bps_one_way": 5,
  "spread_autocorr": 0.0,
  "exkurt": 3.0
 },
 "windows": {
  "dev_years": 5.0,
  "val_years": 5.0
 },
 "gates": {
  "batch_k": 1,
  "stress_drag_sr": 0.1,
  "dev": {
   "kind": "amendment2"
  },
  "val": {
   "kind": "sharpe",
   "value": 0.75,
   "alpha": "auto"
  }
 },
