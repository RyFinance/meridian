{
 "name": "retro_pead_2004_2014",
 "description": "Production PEAD model replayed 2004-2014 (single stage: HAC t >= 2 and positive both halves).",
 "assumptions": [
  "ASSUMPTION 20-day CAR sd 7%",
  "ASSUMPTION signed residual correlation of concurrent events 0.02",
  "ASSUMPTION earnings seasons = 45% of trading days",
  "beats-all-events-control leg not modelled"
 ],
