# Meridian settings. Copy to .env (scripts/setup.sh does this). Never commit .env.

# Desk port (http://127.0.0.1:PORT)
MERIDIAN_PORT=8420

# ---- Live trading: OFF unless you set this to yes ---------------------------
# Live also needs live credentials linked in the desk and the arm phrase typed
# there (e.g. "LIVE ALPACA"). The risk gate and kill switch apply in every mode.
MERIDIAN_ALLOW_LIVE=no
# Largest single live order, in dollars. Bigger approved sizes are clipped.
MERIDIAN_LIVE_MAX_ORDER_USD=500

# ---- Broker credentials (optional; you can link in the desk instead) -------
# Pattern: MERIDIAN_<BROKER>_<PAPER|LIVE>_<FIELD>. Examples:
# MERIDIAN_ALPACA_PAPER_KEY_ID=
# MERIDIAN_ALPACA_PAPER_SECRET_KEY=
# MERIDIAN_TRADIER_PAPER_TOKEN=
# MERIDIAN_TRADIER_PAPER_ACCOUNT_ID=
# MERIDIAN_IBKR_PAPER_GATEWAY_URL=https://localhost:5000

# ---- Alerts / research (optional) ------------------------------------------
# Contact string for SEC EDGAR requests made by research scripts.
RESEARCH_USER_AGENT=
