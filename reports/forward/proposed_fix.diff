--- a/tests/test_bot_forward_hygiene.py	1969-12-31 16:00:00
+++ b/tests/test_bot_forward_hygiene.py	2026-09-23 05:08:33
@@ -0,0 +1,134 @@
+"""Forward-evidence hygiene of the paper bot (reports/forward/PEAD_FORWARD_DIAGNOSIS.md).
+
+Offline: every network touch point is stubbed, every state file is a tmp path.
+"""
+from __future__ import annotations
+
+import json
+
+import pandas as pd
+import pytest
+
+import bot.earnings_watcher as ew
+import bot.execution as ex
+import bot.heartbeat as hb
+import bot.kill_switch as ks
+import bot.risk_gate as rg
+import bot.run_cycle as rc
+import earnings.ingestion as ing
+from bot.earnings_watcher import ReportedEarnings
+from bot.signal_pipeline import ScoredEvent
+
+
+def raising_ticker(*_a, **_k):
+    class Down:
+        def get_earnings_dates(self, limit=100):
+            raise ConnectionError("Could not resolve host: query2.finance.yahoo.com")
+
+        @property
+        def earnings_history(self):
+            raise ConnectionError("Could not resolve host: query2.finance.yahoo.com")
+
+        @property
+        def calendar(self):
+            raise ConnectionError("Could not resolve host: query2.finance.yahoo.com")
+
+    return Down()
+
+
+@pytest.fixture
+def training_cache(tmp_path, monkeypatch):
+    monkeypatch.setattr(ing, "RAW_DIR", tmp_path)
+    pd.DataFrame({"ticker": "AAA", "earnings_date": pd.to_datetime(["2025-03-01 16:30", "2025-06-26 16:30"]),
+                  "eps_estimate": [1.0, 1.1], "eps_actual": [1.1, 1.2], "surprise_pct": [10.0, 9.0]}
+                 ).to_parquet(tmp_path / "AAA.parquet", index=False)
+    return tmp_path
+
+
+def test_network_failure_is_not_an_empty_answer(monkeypatch, training_cache):
+    monkeypatch.setattr(ing.yf, "Ticker", raising_ticker)
+    df = ing.fetch_ticker_earnings_live("AAA", now=pd.Timestamp("2026-09-21"))
+    assert df.attrs["primary_ok"] is False
+    assert "resolve host" in df.attrs["primary_error"] and "resolve host" in df.attrs["history_error"]
+    assert set(df["date_source"]) == {"cached_announced"}
+
+
+def test_watcher_reports_unreachable_data_and_ignores_the_training_cache(monkeypatch, training_cache):
+    monkeypatch.setattr(ing.yf, "Ticker", raising_ticker)
+    watcher = ew.EarningsWatcher(tickers=["AAA", "BBB"])
+    assert watcher.get_recently_reported(days_back=3, now=pd.Timestamp("2026-09-21")) == []
+    assert watcher.fetch_errors == 2 and watcher.data_unreachable()
+    assert watcher.newest_report is None  # 2025-06-26 from the cache is not evidence of anything
+
+
+def test_one_failing_ticker_is_not_an_outage(monkeypatch, training_cache):
+    monkeypatch.setattr(ing.yf, "Ticker", raising_ticker)
+    watcher = ew.EarningsWatcher(tickers=["AAA"] + [f"T{i}" for i in range(19)])
+    monkeypatch.setattr(ew, "fetch_ticker_earnings_live",
+                        lambda t: ing.fetch_ticker_earnings_live(t) if t == "AAA" else pd.DataFrame())
+    watcher.get_recently_reported(days_back=3, now=pd.Timestamp("2026-09-21"))
+    assert watcher.fetch_errors == 1 and not watcher.data_unreachable()
+
+
+@pytest.fixture
+def isolated(tmp_path, monkeypatch):
+    from bot.alerting import BotAlerter
+    alerter = lambda: BotAlerter(webhook_url="", alerts_path=tmp_path / "alerts.jsonl")
+    for module in (rg, ex, rc):
+        monkeypatch.setattr(module, "build_alerter", alerter)
+    monkeypatch.setattr(ks, "KILL_SWITCH_FILE", tmp_path / "KILL_SWITCH")
+    monkeypatch.setattr(rc, "CYCLE_LOG_FILE", tmp_path / "cycle_log.jsonl")
+    monkeypatch.setattr(rc, "BACKFILL_CYCLE_LOG_FILE", tmp_path / "backfill_cycle_log.jsonl")
+    monkeypatch.setattr(rc, "UPCOMING_EARNINGS_FILE", tmp_path / "upcoming_earnings.json")
+    monkeypatch.setattr(rc, "prepare_market_session", lambda tickers, as_of: (True, "test session"))
+    monkeypatch.setattr(rc, "current_breaker_tier", lambda: ("armed", {}))
+    monkeypatch.setattr(rc, "touch_heartbeat", lambda: hb.touch_heartbeat(tmp_path / "heartbeat.txt"))
+    monkeypatch.setattr(ex, "get_current_price", lambda ticker: 100.0)
+    return tmp_path
+
+
+def test_unreachable_cycle_is_degraded_and_does_not_refresh_the_heartbeat(isolated, monkeypatch):
+    def down(self, **kw):
+        self.fetch_errors = len(self.tickers)
+        self.fetch_error_sample = "DNSError"
+        return []
+
+    monkeypatch.setattr(rc.EarningsWatcher, "get_recently_reported", down)
+    report = rc.run_cycle(as_of_date="2026-09-21", ledger_path=isolated / "ledger.jsonl")
+    assert report.degraded and report.marked_nav is None
+    assert any("unreachable" in e for e in report.errors)
+    assert not any("looks stale" in e for e in report.errors)
+    assert not (isolated / "heartbeat.txt").exists()
+    logged = json.loads((isolated / "cycle_log.jsonl").read_text().splitlines()[-1])
+    assert logged["provenance"] == "live" and logged["degraded"] is True and len(logged["code_sha256"]) == 64
+
+
+def test_partial_marks_record_no_marked_nav(isolated, monkeypatch):
+    ledger = isolated / "ledger.jsonl"
+    ledger.write_text(json.dumps({"event": "open", "entry_date": "2026-09-18", "ticker": "AAA", "direction": "long",
+                                  "fill_price": 100.0, "size_fraction": 0.05, "notional": 5000.0, "ts": 0}) + "\n")
+    monkeypatch.setattr(rc.EarningsWatcher, "get_recently_reported", lambda self, **kw: [])
+
+    def no_price(ticker):
+        raise RuntimeError("no price")
+
+    monkeypatch.setattr(ex, "get_current_price", no_price)
+    report = rc.run_cycle(as_of_date="2026-09-21", ledger_path=ledger)
+    assert report.unmarked == ["AAA"] and report.marked_nav is None
+    assert (isolated / "heartbeat.txt").exists()  # a missing mark is reported, not an outage
+
+
+def test_entry_records_decision_time_inputs_and_provenance(isolated, monkeypatch):
+    event = ReportedEarnings(ticker="AZO", earnings_date=pd.Timestamp("2026-09-22 06:00"), eps_estimate=53.89,
+                             eps_actual=56.05, surprise_pct=4.01, days_since=0)
+    monkeypatch.setattr(rc.EarningsWatcher, "get_recently_reported", lambda self, **kw: [event])
+    monkeypatch.setattr(rc, "score_event", lambda e, p: ScoredEvent(
+        ticker="AZO", earnings_date=e.earnings_date, sue=1.18, calibrated_proba=0.9, direction="long",
+        features={"signal": 1.18}, inputs={"eps_estimate": 53.89, "eps_actual": 56.05}))
+    report = rc.run_cycle(as_of_date="2026-09-22", ledger_path=isolated / "ledger.jsonl")
+    entry = report.entries[0]
+    assert entry.allowed and entry.decided_at > 0 and entry.decided_after_close is True
+    assert entry.inputs["eps_estimate"] == 53.89
+    opened = json.loads((isolated / "ledger.jsonl").read_text().splitlines()[-1])
+    assert opened["provenance"] == "live" and opened["decided_at"] == entry.decided_at
+    assert opened["decided_at"] <= opened["ts"]  # decided before the price was fetched
