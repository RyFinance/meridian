+def code_fingerprint(root: Path = REPO_ROOT) -> str:
+    """SHA-256 over (path, file SHA-256) of FINGERPRINT_FILES; missing files count as absent."""
+    h = hashlib.sha256()
+    for rel in FINGERPRINT_FILES:
+        path = root / rel
+        digest = hashlib.sha256(path.read_bytes()).hexdigest() if path.exists() else "absent"
+        h.update(f"{rel}:{digest}\n".encode())
+    return h.hexdigest()
+
